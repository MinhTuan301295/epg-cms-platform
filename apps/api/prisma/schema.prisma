generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

enum AssetType {
  VOD
  LIVE
}

enum ScheduleStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model User {
  id           String             @id @default(uuid()) @db.Uuid
  email        String             @unique
  passwordHash String             @map("password_hash")
  fullName     String             @map("full_name")
  role         UserRole           @default(VIEWER)
  isActive     Boolean            @default(true) @map("is_active")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  auditLogs    ScheduleAuditLog[]

  @@map("users")
}

model Channel {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  slug        String     @unique
  logoUrl     String?    @map("logo_url")
  streamUrl   String?    @map("stream_url")
  description String?
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  schedules   Schedule[]

  @@map("channels")
}

model Asset {
  id        String     @id @default(uuid()) @db.Uuid
  title     String
  type      AssetType
  duration  Int        @map("duration_seconds")
  metadata  Json?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  schedules Schedule[]

  @@map("assets")
}

model Schedule {
  id        String             @id @default(uuid()) @db.Uuid
  channelId String             @map("channel_id") @db.Uuid
  assetId   String?            @map("asset_id") @db.Uuid
  title     String
  startTime DateTime           @map("start_time") @db.Timestamptz(6)
  stopTime  DateTime           @map("stop_time") @db.Timestamptz(6)
  duration  Int                @map("duration_seconds")
  status    ScheduleStatus     @default(DRAFT)
  version   Int                @default(1)
  metadata  Json?
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  channel   Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  asset     Asset?             @relation(fields: [assetId], references: [id], onDelete: SetNull)
  auditLogs ScheduleAuditLog[]

  @@index([channelId])
  @@index([assetId])
  @@index([startTime])
  @@index([stopTime])
  @@index([status])
  @@index([channelId, startTime, stopTime])
  @@map("schedules")
}

model ScheduleAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  scheduleId String   @map("schedule_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([scheduleId])
  @@index([userId])
  @@map("schedule_audit_logs")
}
