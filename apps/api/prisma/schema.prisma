generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

enum AssetType {
  VOD
  LIVE
}

enum ScheduleStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model User {
  id                       String             @id @default(uuid()) @db.Uuid
  email                    String             @unique
  password                 String
  name                     String?
  role                     UserRole           @default(VIEWER)
  isActive                 Boolean            @default(true) @map("is_active")
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdSchedules         Schedule[]         @relation("ScheduleCreatedBy")
  updatedSchedules         Schedule[]         @relation("ScheduleUpdatedBy")
  changedScheduleAuditLogs ScheduleAuditLog[] @relation("ScheduleAuditChangedBy")

  @@index([email])
  @@index([role])
  @@map("users")
}

model Channel {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  epgId     String?    @unique @map("epg_id")
  logoUrl   String?    @map("logo_url")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  schedules Schedule[]

  @@index([epgId])
  @@index([isActive])
  @@map("channels")
}

model Asset {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  type         AssetType
  dashUrl      String?    @map("dash_url")
  hlsUrl       String?    @map("hls_url")
  duration     Int        @map("duration_seconds")
  posterUrl    String?    @map("poster_url")
  thumbnailUrl String?    @map("thumbnail_url")
  metadata     Json?
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  schedules    Schedule[]

  @@index([type])
  @@map("assets")
}

model Schedule {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  channelId   String         @map("channel_id") @db.Uuid
  assetId     String?        @map("asset_id") @db.Uuid
  startTime   DateTime       @map("start_time") @db.Timestamptz(6)
  stopTime    DateTime       @map("stop_time") @db.Timestamptz(6)
  duration    Int            @map("duration_seconds")
  status      ScheduleStatus @default(DRAFT)
  version     Int            @default(1)
  metadata    Json?
  createdById String?        @map("created_by_id") @db.Uuid
  updatedById String?        @map("updated_by_id") @db.Uuid
  publishedAt DateTime?      @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  channel     Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  asset       Asset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  createdBy   User?          @relation("ScheduleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?          @relation("ScheduleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  auditLogs   ScheduleAuditLog[]

  @@index([channelId])
  @@index([assetId])
  @@index([startTime])
  @@index([stopTime])
  @@index([status])
  @@index([channelId, startTime, stopTime])
  @@index([channelId, status, startTime])
  @@map("schedules")
}

model ScheduleAuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  scheduleId  String?   @map("schedule_id") @db.Uuid
  action      String
  beforeData  Json?     @map("before_data")
  afterData   Json?     @map("after_data")
  changedById String?   @map("changed_by_id") @db.Uuid
  changedAt   DateTime  @default(now()) @map("changed_at") @db.Timestamptz(6)
  schedule    Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  changedBy   User?     @relation("ScheduleAuditChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([scheduleId])
  @@index([changedById])
  @@index([changedAt])
  @@map("schedule_audit_logs")
}
