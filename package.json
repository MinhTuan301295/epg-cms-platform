{
  "name": "epg-cms-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:worker": "pnpm --filter @epg-cms/worker dev",
    "worker:dev": "pnpm --filter @epg-cms/worker dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @epg-cms/api db:generate",
    "db:migrate": "pnpm --filter @epg-cms/api db:migrate",
    "db:seed": "pnpm --filter @epg-cms/api db:seed",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
