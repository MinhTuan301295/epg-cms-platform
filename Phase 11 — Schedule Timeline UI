# =====================================================
# 0. START CLEAN
# =====================================================

cd /Users/hmk/Documents/epg-cms-platform

# dùng Node 20 cho Prisma ổn định trên Mac M1
nvm use 20

# =====================================================
# 1. START DATABASE + REDIS
# =====================================================

docker compose down -v

docker compose up -d postgres redis

docker ps

# phải thấy:
# epg-cms-postgres
# epg-cms-redis

# =====================================================
# 2. VERIFY POSTGRES
# =====================================================

docker exec -it epg-cms-postgres psql -U epg -d epg_cms

# nếu vào được:
# epg_cms=#

# thoát:
\q

# =====================================================
# 3. CHECK API ENV
# =====================================================

cat apps/api/.env

# phải là:

# DATABASE_URL="postgresql://epg:epg123@localhost:5433/epg_cms?schema=public"
# JWT_SECRET="change-me"
# JWT_EXPIRES_IN="7d"
# REDIS_HOST="localhost"
# REDIS_PORT="6379"

# =====================================================
# 4. INSTALL DEPENDENCIES
# =====================================================

rm -rf node_modules
rm -rf apps/api/node_modules
rm -rf apps/admin-web/node_modules
rm -rf apps/worker/node_modules

pnpm install

# =====================================================
# 5. GENERATE PRISMA CLIENT
# =====================================================

cd apps/api

export PRISMA_CLI_QUERY_ENGINE_TYPE=binary
export PRISMA_CLIENT_ENGINE_TYPE=binary

pnpm prisma generate

# =====================================================
# 6. RUN DATABASE MIGRATION
# =====================================================

pnpm prisma migrate dev --name init_epg_core

# =====================================================
# 7. SEED DATABASE
# =====================================================

pnpm db:seed

# =====================================================
# 8. VERIFY TABLES
# =====================================================

cd /Users/hmk/Documents/epg-cms-platform

docker exec -it epg-cms-postgres psql -U epg -d epg_cms -c "\dt"

# phải thấy:
# users
# channels
# assets
# schedules
# schedule_audit_logs

# =====================================================
# 9. VERIFY ADMIN USER
# =====================================================

docker exec -it epg-cms-postgres psql -U epg -d epg_cms -c "select email, role from users;"

# phải thấy:
# admin@epg.local

# =====================================================
# 10. START API
# =====================================================

cd apps/api

export DATABASE_URL="postgresql://epg:epg123@localhost:5433/epg_cms?schema=public"

pnpm dev

# nếu OK sẽ thấy:
# Nest application successfully started

# API:
# http://localhost:3001

